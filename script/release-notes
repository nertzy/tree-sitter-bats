#!/usr/bin/env bash
# Print the CHANGELOG.md section for a version, without its heading.
# Fail when the section is missing or empty.
set -euo pipefail

version=${1:?usage: script/release-notes <version>}
changelog="$(dirname "$0")/../CHANGELOG.md"

notes=$(awk -v heading="## [$version]" '
  index($0, heading) == 1 { found = 1; next }
  found && /^## / { exit }
  found { print }
' "$changelog" | sed '/./,$!d')

if [[ -z "${notes//[[:space:]]/}" ]]; then
  echo "CHANGELOG.md has no notes for $version" >&2
  exit 1
fi

printf '%s\n' "$notes"
