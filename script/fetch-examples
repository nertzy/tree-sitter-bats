#!/usr/bin/env bash
# Shallow-fetch each suite in script/example-repos.txt into examples/ at its pinned commit.
set -euo pipefail
cd "$(dirname "$0")/.."

while read -r dir repo commit; do
  [[ -z $dir || $dir == \#* ]] && continue
  target="examples/$dir"
  if [[ ! -d $target/.git ]]; then
    git init -q "$target"
    git -C "$target" remote add origin "https://github.com/$repo.git"
  fi
  if [[ $(git -C "$target" rev-parse -q --verify HEAD || true) != "$commit" ]]; then
    git -C "$target" fetch -q --depth=1 origin "$commit"
    git -C "$target" checkout -q --detach FETCH_HEAD
  fi
done < script/example-repos.txt
